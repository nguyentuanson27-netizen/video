  "cues": [
    {
      "cue": 1,
      "beat": 1,
      "start_sample": 34560,
      "end_sample": 188794,
      "text": "Một chiếc áo khoác đủ để phân thắng bại."
    },
    {
      "cue": 2,
      "beat": 1,
      "start_sample": 211834,
      "end_sample": 430710,
      "text": "Gió Bắc và Mặt Trời cá xem ai khiến một lữ khách cởi áo trước."
    },
    {
      "cue": 3,
      "beat": 1,
      "start_sample": 453750,
      "end_sample": 614111,
      "text": "Anh vẫn lặng lẽ bước, hai tay giấu dưới tà áo."
